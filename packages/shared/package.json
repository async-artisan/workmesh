    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
