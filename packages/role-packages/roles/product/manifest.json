      "contractVersion": "1.0",
      "templateResourceId": "template-understanding"
    },
    {
      "key": "prd",
      "channel": "CANDIDATE",
      "kind": "PRD",
      "contractVersion": "1.0",
      "templateResourceId": "template-prd",
      "evidence": [
        "INSPECTION"
      ]
    }
  ],
