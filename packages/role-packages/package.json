{
  "name": "@workmesh/role-packages",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "roles"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsup",
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "generate": "node scripts/build.mjs"
  },
  "dependencies": {
    "@workmesh/shared": "workspace:*"
  },
  "devDependencies": {
    "js-yaml": "^4.3.2",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
