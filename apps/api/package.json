{
  "name": "@reqflow/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "pretest": "prisma generate --schema prisma/schema.prisma",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "pretype-check": "prisma generate --schema prisma/schema.prisma",
    "type-check": "tsc --noEmit",
    "prebuild": "prisma generate --schema prisma/schema.prisma",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:audit-cleanup": "tsx prisma/cleanup-audit-logs.ts",
    "db:import-kb": "tsx --env-file=.env prisma/import-knowledge-base.ts",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.5",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.5",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.5",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "redis": "6.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/testing": "^10.4.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "2.1.9",
    "prisma": "^5.21.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
