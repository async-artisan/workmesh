# Local development only. Production uses SECURE mode and an HTTPS public origin.
PORT=3000
WORKMESH_V1_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/workmesh?schema=workmesh_v1
WORKMESH_COOKIE_MODE=LOCAL_INSECURE
WORKMESH_PUBLIC_ORIGIN=http://127.0.0.1:5173
WEB_ORIGIN=http://127.0.0.1:5173
GITHUB_WEBHOOK_SECRET=
# Required only for code-evidence ticket preparation. Use a separate random 32-byte hex key.
WORKMESH_TICKET_ENCRYPTION_KEY=
RATE_LIMIT_MAX=120
RATE_LIMIT_BUCKETS=10000
# Only list reverse proxies controlled by this deployment. Empty means no trust.
TRUSTED_PROXY_IPS=
# Optional mail digest configuration.
WORKMESH_SMTP_URL=
WORKMESH_EMAIL_FROM=
