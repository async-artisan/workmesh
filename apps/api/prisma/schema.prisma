  project       Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  evidence      CodeReviewEvidence[]

  @@unique([source, deliveryId])
  @@index([projectId, receivedAt])
  @@schema("workmesh_v1")
}

