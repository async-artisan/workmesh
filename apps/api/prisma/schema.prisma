generator client {
  provider        = "prisma-client-js"
  output          = "../../node_modules/.prisma/workmesh-v1-client"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("WORKMESH_V1_DATABASE_URL")
  schemas  = ["workmesh_v1"]
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  @@schema("workmesh_v1")
}
enum Visibility {
  PROJECT
  RESTRICTED
  @@schema("workmesh_v1")
}
enum GrantSubjectKind {
  USER
  ROLE
  @@schema("workmesh_v1")
}
enum DocumentKind {
  UNDERSTANDING
  DECISION
  PRD
  KNOWLEDGE
  @@schema("workmesh_v1")
}
enum PublicationKind {
  PUBLISH
  WITHDRAW
  @@schema("workmesh_v1")
}
enum WorkflowStepKind {
  PRODUCT
  DELIVERY
  VERIFY
  RELEASE
  @@schema("workmesh_v1")
}
enum BaselinePolicy {
  NONE
  PUBLISHED_PRD
  @@schema("workmesh_v1")
}
enum TaskExecutionStatus {
  OPEN
  IN_PROGRESS
  REVIEW_PENDING
  DONE
  @@schema("workmesh_v1")
}
enum WorkStatus {
  ACTIVE
  BLOCKED
  PAUSED
  CANCELLED
  @@schema("workmesh_v1")
}
enum ArtifactKind {
  PRD
  DESIGN
  IMPL
  CASES
  RELEASE
  @@schema("workmesh_v1")
}
enum ArtifactStorage {
  HOSTED
  GIT_REF
  @@schema("workmesh_v1")
}
enum ReviewKind {
  UNDERSTANDING_CONFIRM
  PRD_PUBLICATION
  KNOWLEDGE_PUBLICATION
  TASK_ACCEPTANCE
  RELEASE_ACCEPTANCE
  @@schema("workmesh_v1")
}
enum ReviewStatus {
  OPEN
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  INVALIDATED
  @@schema("workmesh_v1")
}
enum DecisionKind {
  APPROVE
  CHANGES_REQUESTED
  REJECT
  @@schema("workmesh_v1")
}

model User {
  id           String @id @default(uuid()) @db.Uuid
  email        String @unique @db.VarChar(254)
  passwordHash String @db.VarChar(255)
  isActive     Boolean @default(true)
  authVersion  Int @default(1)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  projects     ProjectMember[]
  roles        ProjectRoleAssignment[]
  grants       KnowledgeBaseGrant[]
  sessions     WebSession[]
  credentials  AgentCredential[]
  approverFor  KnowledgeBase[] @relation("KnowledgeBaseApprover")
  responsibleTasks Task[] @relation("TaskResponsible")
  claims       TaskClaim[] @relation("TaskClaimUser")
  changeRecipients ChangeRecipient[] @relation("ChangeRecipientUser")
  approvalSlots ApprovalSlot[] @relation("ApprovalSlotUser")
  authoredRevisions DocumentRevision[] @relation("DocumentRevisionAuthor")
  tickets       ConfirmationTicket[]
  stamps        PrincipalStamp[] @relation("StampUser")
  cliViews      CliAuthorizationView[]
  cliApprovals  CliAuthorizationRequest[] @relation("CliApprovedUser")

  @@schema("workmesh_v1")
}

model Project {
  id                    String @id @default(uuid()) @db.Uuid
  key                   String @db.VarChar(6)
  name                  String @db.VarChar(120)
  description           String? @db.VarChar(10000)
  version               Int @default(1)
  knowledgeBindingsVersion Int @default(1)
  archivedAt            DateTime? @db.Timestamptz(3)
  createdById           String @db.Uuid
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)
  members               ProjectMember[]
  roles                 ProjectRole[]
  roleAssignments       ProjectRoleAssignment[]
  grants                KnowledgeBaseGrant[]
  knowledgeBases        KnowledgeBase[]
  documents             KnowledgeDocument[]
  requirements          Requirement[]
  credentials           AgentCredential[]
  workflows             WorkflowDefinition[]
  operations            IdempotentOperation[]
  codeReviewEvidence    CodeReviewEvidence[]
  webhookReceipts       WebhookReceipt[]
  rolePackages          RolePackageVersion[]
  knowledgeBindings     ProjectKnowledgeBinding[]
  repositories          ProjectRepository[]
  tickets               ConfirmationTicket[] @relation("TicketProject")
  stamps                PrincipalStamp[] @relation("StampProject")
  auditEvents           AuditEvent[] @relation("AuditProject")

  @@unique([key])
  @@index([archivedAt])
  @@schema("workmesh_v1")
}

model ProjectMember {
  projectId    String @db.Uuid
  userId       String @db.Uuid
  role         MemberRole
  version      Int @default(1)
  grantedAt    DateTime @default(now()) @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  project      Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user         User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([projectId, userId])
  @@index([userId, revokedAt])
  @@schema("workmesh_v1")
}

model ProjectRole {
  id          String @id @default(uuid()) @db.Uuid
  projectId   String @db.Uuid
  key         String @db.VarChar(48)
  title       String @db.VarChar(80)
  isActive    Boolean @default(true)
  version     Int @default(1)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  project     Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  assignments ProjectRoleAssignment[]
  grants      KnowledgeBaseGrant[]
  credentials AgentCredential[]
  tasks       Task[]
  approvalSlots ApprovalSlot[]
  approverForKnowledgeBases KnowledgeBase[] @relation("KnowledgeBaseApproverRole")
  knowledgeBindings ProjectKnowledgeBinding[]

  @@unique([projectId, key])
  @@unique([id, projectId])
  @@index([projectId, isActive])
  @@schema("workmesh_v1")
}

model ProjectRoleAssignment {
  id         String @id @default(uuid()) @db.Uuid
  projectId  String @db.Uuid
  userId     String @db.Uuid
  roleId     String @db.Uuid
  version    Int @default(1)
  grantedAt  DateTime @default(now()) @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  project    Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user       User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role       ProjectRole @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId, roleId])
  @@index([projectId, roleId, revokedAt])
  @@schema("workmesh_v1")
}

model KnowledgeBase {
  id                      String @id @default(uuid()) @db.Uuid
  projectId               String @db.Uuid
  key                     String @db.VarChar(48)
  name                    String @db.VarChar(120)
  /// BUSINESS | SYSTEM | PRACTICE，模板层可扩展
  kind                    String @default("SYSTEM") @db.VarChar(16)
  visibility              Visibility
  version                 Int @default(1)
  authzVersion            Int @default(1)
  publicationApproverUserId String @db.Uuid
  publicationApproverRoleId String? @db.Uuid
  archivedAt              DateTime? @db.Timestamptz(3)
  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)
  project                 Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  approver                User @relation("KnowledgeBaseApprover", fields: [publicationApproverUserId], references: [id], onDelete: Restrict)
  approverRole            ProjectRole? @relation("KnowledgeBaseApproverRole", fields: [publicationApproverRoleId], references: [id], onDelete: Restrict)
  grants                  KnowledgeBaseGrant[]
  documents               KnowledgeDocument[]

  @@unique([projectId, key])
  @@index([projectId, archivedAt])
  @@schema("workmesh_v1")
}

model KnowledgeBaseGrant {
  id              String @id @default(uuid()) @db.Uuid
  projectId       String @db.Uuid
  knowledgeBaseId String @db.Uuid
  subjectKind     GrantSubjectKind
  subjectUserId   String? @db.Uuid
  subjectRoleId   String? @db.Uuid
  permissions     String[]
  version         Int @default(1)
  grantedAt       DateTime @default(now()) @db.Timestamptz(3)
  revokedAt       DateTime? @db.Timestamptz(3)
  project         Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Restrict)
  subjectUser     User? @relation(fields: [subjectUserId], references: [id], onDelete: Restrict)
  subjectRole     ProjectRole? @relation(fields: [subjectRoleId], references: [id], onDelete: Restrict)

  @@index([knowledgeBaseId, revokedAt])
  @@schema("workmesh_v1")
}

model KnowledgeDocument {
  id                      String @id @default(uuid()) @db.Uuid
  projectId               String @db.Uuid
  knowledgeBaseId         String @db.Uuid
  requirementId           String? @db.Uuid
  kind                    DocumentKind
  /// PROJECT | UNIT | ROLE
  scopeKind               String @default("PROJECT") @db.VarChar(16)
  scopeId                 String? @db.Uuid
  ownerUserId             String? @db.Uuid
  reviewDueAt             DateTime? @db.Timestamptz(3)
  supersededById          String? @db.Uuid
  version                 Int @default(1)
  nextRevisionSeq         Int @default(1)
  currentPublishedRevisionId String? @db.Uuid
  archivedAt              DateTime? @db.Timestamptz(3)
  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)
  project                 Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  knowledgeBase           KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Restrict)
  revisions               DocumentRevision[]
  knowledgeBindings       ProjectKnowledgeBinding[]

  @@unique([id, projectId])
  @@index([projectId, knowledgeBaseId])
  @@schema("workmesh_v1")
}

model DocumentRevision {
  id          String @id @default(uuid()) @db.Uuid
  projectId   String @db.Uuid
  documentId  String @db.Uuid
  seq         Int
  title       String @db.VarChar(200)
  mimeType    String @db.VarChar(100)
  bodyBytes   Bytes
  byteLength  Int
  sha256      String @db.Char(64)
  sourceRef   Json?
  basisUnderstandingRevisionId String? @db.Uuid
  deliveryScope Json?
  acceptance Json?
  /// HIGH | MEDIUM | LOW；老项目重建时区分机器结论与推断
  confidence  String @default("MEDIUM") @db.VarChar(16)
  evidenceRefs Json?
  createdById String @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  document    KnowledgeDocument @relation(fields: [documentId, projectId], references: [id, projectId], onDelete: Restrict)
  author      User @relation("DocumentRevisionAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  publications DocumentPublication[]
  reviewRequests ReviewRequest[]
  requirementUnderstandingFor Requirement[] @relation("RequirementCurrentUnderstanding")
  requirementPrdFor Requirement[] @relation("RequirementCurrentPrd")
  artifactSetItems ArtifactSetItem[]

  @@unique([documentId, seq])
  @@unique([id, projectId])
  @@index([projectId, sha256])
  @@schema("workmesh_v1")
}

model DocumentPublication {
  id         String @id @default(uuid()) @db.Uuid
  projectId  String @db.Uuid
  documentId String @db.Uuid
  revisionId String @db.Uuid
  kind       PublicationKind
  reviewRequestId String? @db.Uuid
  previousPublicationId String? @db.Uuid
  reason     String? @db.VarChar(1000)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  revision   DocumentRevision @relation(fields: [revisionId, projectId], references: [id, projectId], onDelete: Restrict)

  @@index([documentId, createdAt])
  @@schema("workmesh_v1")
}

model Requirement {
  id          String @id @default(uuid()) @db.Uuid
  projectId   String @db.Uuid
  seq         Int
  code        String @db.VarChar(32)
  title       String @db.VarChar(200)
  description String? @db.VarChar(10000)
  version     Int @default(1)
  generation  Int @default(1)
  phase       String @default("DISCOVERY") @db.VarChar(32)
  workStatus  WorkStatus @default(ACTIVE)
  currentUnderstandingRevisionId String? @db.Uuid
  currentPrdRevisionId String? @db.Uuid
  deliveryScope Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  project     Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  instances   WorkflowInstance[]
  currentUnderstandingRevision DocumentRevision? @relation("RequirementCurrentUnderstanding", fields: [currentUnderstandingRevisionId], references: [id], onDelete: Restrict)
  currentPrdRevision DocumentRevision? @relation("RequirementCurrentPrd", fields: [currentPrdRevisionId], references: [id], onDelete: Restrict)
  snapshots   ContextSnapshot[]

  @@unique([projectId, seq])
  @@unique([projectId, code])
  @@unique([id, projectId])
  @@schema("workmesh_v1")
}

model WebSession {
  id             String @id @default(uuid()) @db.Uuid
  userId         String? @db.Uuid
  tokenHash      String @unique @db.Char(64)
  csrfTokenHash  String @db.Char(64)
  userAuthVersion Int?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt     DateTime @default(now()) @db.Timestamptz(3)
  idleExpiresAt  DateTime @db.Timestamptz(3)
  expiresAt      DateTime @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  user           User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  tickets        ConfirmationTicket[]
  stamps         PrincipalStamp[]
  cliViews       CliAuthorizationView[]

  @@index([userId, revokedAt, expiresAt])
  @@schema("workmesh_v1")
}

model AgentCredential {
  id                     String @id @default(uuid()) @db.Uuid
  userId                 String @db.Uuid
  projectId              String @db.Uuid
  roleId                 String @db.Uuid
  tokenHash              String @unique @db.Char(64)
  name                   String @db.VarChar(80)
  scopes                 String[]
  userAuthVersion        Int
  authorizedAt           DateTime @default(now()) @db.Timestamptz(3)
  createdAt              DateTime @default(now()) @db.Timestamptz(3)
  expiresAt              DateTime @db.Timestamptz(3)
  revokedAt              DateTime? @db.Timestamptz(3)
  user                   User @relation(fields: [userId], references: [id], onDelete: Restrict)
  project                Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  role                   ProjectRole @relation(fields: [roleId, projectId], references: [id, projectId], onDelete: Restrict)
  authorizedByStampId    String? @db.Uuid
  authorizedByStamp      PrincipalStamp? @relation("CredentialAuthorizedByStamp", fields: [authorizedByStampId], references: [id], onDelete: Restrict)
  authorizationRequest   CliAuthorizationRequest?
  stamps                 PrincipalStamp[]

  @@index([projectId, revokedAt, expiresAt])
  @@schema("workmesh_v1")
}

model WorkflowDefinition {
  id          String @id @default(uuid()) @db.Uuid
  projectId   String @db.Uuid
  workflowKey String @db.VarChar(48)
  version     Int @default(1)
  currentRevisionId String? @db.Uuid
  project     Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  revisions   WorkflowRevision[]
  instances   WorkflowInstance[]
  @@unique([projectId, workflowKey])
  @@schema("workmesh_v1")
}

model WorkflowRevision {
  id           String @id @default(uuid()) @db.Uuid
  projectId    String @db.Uuid
  definitionId String @db.Uuid
  revision     Int
  digest       String @db.Char(64)
  definition   Json
  compiledRules Json
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  definitionRel WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  snapshots    ContextSnapshot[]
  artifactSets ArtifactSet[]
  @@unique([definitionId, revision])
  @@schema("workmesh_v1")
}

model WorkflowInstance {
  id             String @id @default(uuid()) @db.Uuid
  projectId      String @db.Uuid
  definitionId   String @db.Uuid
  definitionRevisionId String? @db.Uuid
  definitionDigest String? @db.Char(64)
  requirementId  String @db.Uuid
  version        Int @default(1)
  workStatus     WorkStatus @default(ACTIVE)
  bindings       Json?
  retiredAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  definition     WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  requirement    Requirement @relation(fields: [requirementId, projectId], references: [id, projectId], onDelete: Restrict)
  tasks          Task[]
  @@unique([id, projectId])
  @@index([requirementId, retiredAt])
  @@schema("workmesh_v1")
}

model Task {
  id              String @id @default(uuid()) @db.Uuid
  projectId       String @db.Uuid
  workflowInstanceId String @db.Uuid
  stepKey         String @db.VarChar(48)
  /// 本任务覆盖的验收 key（来自 PRD acceptance[].key）
  acceptanceKeys  String[] @default([]) @db.Text
  roleId          String @db.Uuid
  responsibleUserId String @db.Uuid
  version         Int @default(1)
  generation      Int @default(1)
  executionStatus TaskExecutionStatus @default(OPEN)
  workStatus      WorkStatus @default(ACTIVE)
  currentClaimId  String? @db.Uuid
  currentSnapshotId String? @db.Uuid
  currentArtifactSetId String? @db.Uuid
  instance        WorkflowInstance @relation(fields: [workflowInstanceId, projectId], references: [id, projectId], onDelete: Restrict)
  role            ProjectRole @relation(fields: [roleId, projectId], references: [id, projectId], onDelete: Restrict)
  responsibleUser User @relation("TaskResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  claims          TaskClaim[]
  snapshots       ContextSnapshot[]
  artifactSets    ArtifactSet[]
  reviews         ReviewRequest[]
  @@unique([workflowInstanceId, stepKey])
  @@unique([id, projectId])
  @@schema("workmesh_v1")
}

model TaskClaim {
  id          String @id @default(uuid()) @db.Uuid
  projectId   String @db.Uuid
  taskId      String @db.Uuid
  taskGeneration Int
  userId      String @db.Uuid
  credentialId String? @db.Uuid
  claimedAt   DateTime @default(now()) @db.Timestamptz(3)
  releasedAt  DateTime? @db.Timestamptz(3)
  releaseReason String? @db.VarChar(1000)
  task        Task @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Restrict)
  user        User @relation("TaskClaimUser", fields: [userId], references: [id], onDelete: Restrict)
  snapshots   ContextSnapshot[]
  @@index([taskId, releasedAt])
  @@schema("workmesh_v1")
}

/// 上下文快照不可变：manifest 只记录可验证的引用与摘要，读取时按当前授权逐项复核。
model ContextSnapshot {
  id              String @id @default(uuid()) @db.Uuid
  projectId       String @db.Uuid
  requirementId   String @db.Uuid
  taskId          String @db.Uuid
  requirementGeneration Int
  taskGeneration  Int
  workflowDefinitionRevisionId String @db.Uuid
  claimId         String @db.Uuid
  manifest        Json
  manifestDigest  String @db.Char(64)
  createdByStampId String @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  task            Task @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Restrict)
  requirement     Requirement @relation(fields: [requirementId, projectId], references: [id, projectId], onDelete: Restrict)
  definitionRevision WorkflowRevision @relation(fields: [workflowDefinitionRevisionId], references: [id], onDelete: Restrict)
  claim           TaskClaim @relation(fields: [claimId], references: [id], onDelete: Restrict)
  createdByStamp  PrincipalStamp @relation(fields: [createdByStampId], references: [id], onDelete: Restrict)
  resources       SnapshotResourceRef[]
  @@unique([id, projectId])
  @@index([taskId, taskGeneration])
  @@index([requirementId, requirementGeneration])
  @@schema("workmesh_v1")
}

/// 管理员显式指定的项目知识绑定；roleId 为空表示对全项目角色生效。
model ProjectKnowledgeBinding {
  id               String   @id @default(uuid()) @db.Uuid
  projectId        String   @db.Uuid
  documentId       String   @db.Uuid
  roleId           String?  @db.Uuid
  required         Boolean  @default(true)
  createdByStampId String?  @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  document         KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  role             ProjectRole? @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdByStamp   PrincipalStamp? @relation(fields: [createdByStampId], references: [id], onDelete: Restrict)

  @@unique([projectId, documentId, roleId])
  @@index([projectId, roleId])
  @@schema("workmesh_v1")
}

model ArtifactSet {
  id              String @id @default(uuid()) @db.Uuid
  projectId       String @db.Uuid
  taskId          String @db.Uuid
  taskGeneration  Int
  snapshotId      String @db.Uuid
  manifestDigest  String @db.Char(64)
  workflowDefinitionRevisionId String @db.Uuid
  localRunId      String @db.VarChar(120)
  createdByStampId String @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  task            Task @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Restrict)
  definitionRevision WorkflowRevision @relation(fields: [workflowDefinitionRevisionId], references: [id], onDelete: Restrict)
  createdByStamp  PrincipalStamp @relation(fields: [createdByStampId], references: [id], onDelete: Restrict)
  artifacts       Artifact[]
  items           ArtifactSetItem[]
  codeReviewEvidence CodeReviewEvidence[]
  @@unique([id, projectId])
  @@index([taskId, taskGeneration])
  @@schema("workmesh_v1")
}

model ArtifactSetItem {
  id                  String @id @default(uuid()) @db.Uuid
  projectId           String @db.Uuid
  artifactSetId       String @db.Uuid
  artifactId          String? @db.Uuid
  candidateRevisionId String? @db.Uuid
  artifactSet         ArtifactSet @relation(fields: [artifactSetId, projectId], references: [id, projectId], onDelete: Restrict)
  artifact            Artifact? @relation(fields: [artifactId], references: [id], onDelete: Restrict)
  candidateRevision   DocumentRevision? @relation(fields: [candidateRevisionId], references: [id], onDelete: Restrict)
  @@unique([artifactSetId, artifactId])
  @@unique([artifactSetId, candidateRevisionId])
  @@index([candidateRevisionId])
  @@schema("workmesh_v1")
}

model Artifact {
  id             String @id @default(uuid()) @db.Uuid
  projectId      String @db.Uuid
  taskId         String @db.Uuid
  artifactSetId  String @db.Uuid
  kind           ArtifactKind
  schemaVersion  String @db.VarChar(16)
  storage        ArtifactStorage
  mediaType      String @db.VarChar(100)
  byteLength     Int
  sha256         String @db.Char(64)
  bodyBytes      Bytes?
  projectRepositoryId String? @db.Uuid
  commitSha      String? @db.VarChar(128)
  repoPath       String? @db.VarChar(500)
  summary        String? @db.VarChar(2000)
  checks         Json
  submittedByStampId String @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  artifactSet    ArtifactSet @relation(fields: [artifactSetId, projectId], references: [id, projectId], onDelete: Restrict)
  submittedByStamp PrincipalStamp @relation(fields: [submittedByStampId], references: [id], onDelete: Restrict)
  setItems       ArtifactSetItem[]
  @@index([taskId, kind])
  @@schema("workmesh_v1")
}

model ReviewRequest {
  id             String @id @default(uuid()) @db.Uuid
  projectId      String @db.Uuid
  kind           ReviewKind
  documentRevisionId String? @db.Uuid
  artifactSetId  String? @db.Uuid
  taskId         String? @db.Uuid
  taskGeneration Int?
  subjectDigest  String @db.Char(64)
  version        Int @default(1)
  status         ReviewStatus @default(OPEN)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  documentRevision DocumentRevision? @relation(fields: [documentRevisionId], references: [id], onDelete: Restrict)
  task           Task? @relation(fields: [taskId], references: [id], onDelete: Restrict)
  approvalSlots  ApprovalSlot[]
  decisions      ReviewDecision[]
  @@unique([id, projectId])
  @@index([projectId, status])
  @@index([documentRevisionId, status])
  @@schema("workmesh_v1")
}

model ApprovalSlot {
  id              String @id @default(uuid()) @db.Uuid
  projectId       String @db.Uuid
  reviewRequestId String @db.Uuid
  slotKey         String @db.VarChar(48)
  kind            String @db.VarChar(48)
  requiredUserId  String? @db.Uuid
  requiredRoleId  String? @db.Uuid
  sourceSlotBindingId String? @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  reviewRequest   ReviewRequest @relation(fields: [reviewRequestId, projectId], references: [id, projectId], onDelete: Restrict)
  requiredUser    User? @relation("ApprovalSlotUser", fields: [requiredUserId], references: [id], onDelete: Restrict)
  requiredRole    ProjectRole? @relation(fields: [requiredRoleId], references: [id], onDelete: Restrict)
  decisions       ReviewDecision[]
  tickets         ConfirmationTicket[]
  @@unique([reviewRequestId, slotKey])
  @@unique([id, projectId])
  @@schema("workmesh_v1")
}

model ReviewDecision {
  id              String @id @default(uuid()) @db.Uuid
  projectId       String @db.Uuid
  reviewRequestId String @db.Uuid
  approvalSlotId  String @db.Uuid
  decision        DecisionKind
  subjectDigest   String @db.Char(64)
  comment         String? @db.VarChar(2000)
  confirmationTicketId String? @db.Uuid
  createdByStampId String? @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  reviewRequest   ReviewRequest @relation(fields: [reviewRequestId, projectId], references: [id, projectId], onDelete: Restrict)
  approvalSlot    ApprovalSlot @relation(fields: [approvalSlotId, projectId], references: [id, projectId], onDelete: Restrict)
  confirmationTicket ConfirmationTicket? @relation(fields: [confirmationTicketId], references: [id], onDelete: Restrict)
  createdByStamp  PrincipalStamp? @relation(fields: [createdByStampId], references: [id], onDelete: Restrict)
  revocation      ReviewDecisionRevocation?
  @@unique([reviewRequestId, approvalSlotId])
  @@index([approvalSlotId])
  @@schema("workmesh_v1")
}

model ReviewDecisionRevocation {
  id              String @id @default(uuid()) @db.Uuid
  projectId       String @db.Uuid
  decisionId      String @db.Uuid
  reason          String @db.VarChar(1000)
  confirmationTicketId String? @db.Uuid
  createdByStampId String? @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  decision        ReviewDecision @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  createdByStamp  PrincipalStamp? @relation("RevocationStamp", fields: [createdByStampId], references: [id], onDelete: Restrict)
  @@unique([decisionId])
  @@schema("workmesh_v1")
}

model ChangeEvent {
  id          String @id @default(uuid()) @db.Uuid
  projectId   String @db.Uuid
  requirementId String? @db.Uuid
  sourceKind  String @db.VarChar(40)
  sourceId    String @db.Uuid
  changedFields String[]
  targets     Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  recipients  ChangeRecipient[]
  @@index([projectId, createdAt])
  @@schema("workmesh_v1")
}

model ChangeRecipient {
  id         String @id @default(uuid()) @db.Uuid
  projectId  String @db.Uuid
  eventId    String @db.Uuid
  userId     String @db.Uuid
  roleId     String? @db.Uuid
  version    Int @default(1)
  ackedAt    DateTime? @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  event      ChangeEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user       User @relation("ChangeRecipientUser", fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, ackedAt, createdAt])
  @@schema("workmesh_v1")
}

model ConfirmationTicket {
  id              String @id @default(uuid()) @db.Uuid
  secretHash      String @unique @db.Char(64)
  userId          String @db.Uuid
  webSessionId    String @db.Uuid
  projectId       String? @db.Uuid
  userAuthVersion Int
  action          String @db.VarChar(64)
  targetType      String @db.VarChar(40)
  /// 目标标识按动作类型而异：项目成员/评审是 UUID，工作流是 workflowKey，角色包是 packageId。
  /// 因此不能是 Uuid 列，否则非 UUID 目标的票据在写入时就失败。
  targetId        String @db.VarChar(200)
  expectedVersion Int
  actionDigest    String @db.Char(64)
  roleId          String? @db.Uuid
  approvalSlotId  String? @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  expiresAt       DateTime @db.Timestamptz(3)
  consumedAt      DateTime? @db.Timestamptz(3)
  consumedRequestId String? @db.Uuid
  invalidatedAt   DateTime? @db.Timestamptz(3)
  user            User @relation(fields: [userId], references: [id], onDelete: Restrict)
  webSession      WebSession @relation(fields: [webSessionId], references: [id], onDelete: Restrict)
  project         Project? @relation("TicketProject", fields: [projectId], references: [id], onDelete: Restrict)
  approvalSlot    ApprovalSlot? @relation(fields: [approvalSlotId], references: [id], onDelete: Restrict)
  /// 审计指针：指向消费该票据的幂等操作。故意不加外键——票据消费发生在
  /// 操作行写入之前，加 FK 会让所有"票据门禁"动作在真实库上以 23503 失败。
  consumedOperationId String? @db.Uuid
  decisions       ReviewDecision[]

  @@index([webSessionId, expiresAt])
  @@index([userId, action, targetId])
  @@index([expiresAt])
  @@schema("workmesh_v1")
}

model PrincipalStamp {
  id                  String @id @default(uuid()) @db.Uuid
  kind                String @db.VarChar(8)
  userId              String @db.Uuid
  webSessionId        String? @db.Uuid
  agentCredentialId   String? @db.Uuid
  projectId           String? @db.Uuid
  roleId              String? @db.Uuid
  roleKeySnapshot     String? @db.VarChar(48)
  scopeSnapshot       String[]
  userAuthVersion     Int
  memberVersion       Int?
  roleAssignmentVersion Int?
  credentialVersion   Int?
  requestId           String? @db.Uuid
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  user                User @relation("StampUser", fields: [userId], references: [id], onDelete: Restrict)
  webSession          WebSession? @relation(fields: [webSessionId], references: [id], onDelete: Restrict)
  agentCredential     AgentCredential? @relation(fields: [agentCredentialId], references: [id], onDelete: Restrict)
  project             Project? @relation("StampProject", fields: [projectId], references: [id], onDelete: Restrict)
  auditEvents         AuditEvent[]
  decisions           ReviewDecision[]
  revocations         ReviewDecisionRevocation[] @relation("RevocationStamp")
  cliApprovals        CliAuthorizationRequest[] @relation("CliApprovedByStamp")
  cliDenials          CliAuthorizationRequest[] @relation("CliDeniedByStamp")
  issuedCredentials   AgentCredential[] @relation("CredentialAuthorizedByStamp")
  rolePackageVersions RolePackageVersion[]
  snapshots           ContextSnapshot[]
  knowledgeBindings   ProjectKnowledgeBinding[]
  artifactSets        ArtifactSet[]
  submittedArtifacts  Artifact[]

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@index([agentCredentialId, createdAt])
  @@schema("workmesh_v1")
}

model AuditEvent {
  id          String @id @default(uuid()) @db.Uuid
  projectId   String? @db.Uuid
  actorStampId String? @db.Uuid
  webhookReceiptId String? @db.Uuid
  action      String @db.VarChar(64)
  targetType  String @db.VarChar(40)
  targetId    String @db.Uuid
  targetVersion Int?
  outcome     String @db.VarChar(16)
  reasonCode  String? @db.VarChar(64)
  details     Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  project     Project? @relation("AuditProject", fields: [projectId], references: [id], onDelete: Restrict)
  actorStamp  PrincipalStamp? @relation(fields: [actorStampId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([actorStampId])
  @@schema("workmesh_v1")
}

model CliAuthorizationRequest {
  id                   String @id @default(uuid()) @db.Uuid
  clientName           String @db.VarChar(80)
  deviceCodeHash       String @unique @db.Char(64)
  userCodeHash         String @unique @db.Char(64)
  codeChallenge        String @db.Char(43)
  codeChallengeMethod  String @db.VarChar(8)
  credentialSecretHash String @db.Char(64)
  status               String @default("PENDING") @db.VarChar(16)
  version              Int @default(1)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  expiresAt            DateTime @db.Timestamptz(3)
  nextPollAt           DateTime @default(now()) @db.Timestamptz(3)
  approvedUserId       String? @db.Uuid
  approvedProjectId    String? @db.Uuid
  approvedRoleId       String? @db.Uuid
  approvedScopes       String[]
  approvedExpiresInDays Int?
  approvedByStampId    String? @db.Uuid
  approvedAt           DateTime? @db.Timestamptz(3)
  issuedCredentialId   String? @unique @db.Uuid
  issuedAt             DateTime? @db.Timestamptz(3)
  recoveryExpiresAt    DateTime? @db.Timestamptz(3)
  deniedAt             DateTime? @db.Timestamptz(3)
  deniedByStampId      String? @db.Uuid
  approvedUser         User? @relation("CliApprovedUser", fields: [approvedUserId], references: [id], onDelete: Restrict)
  approvedByStamp      PrincipalStamp? @relation("CliApprovedByStamp", fields: [approvedByStampId], references: [id], onDelete: Restrict)
  deniedByStamp        PrincipalStamp? @relation("CliDeniedByStamp", fields: [deniedByStampId], references: [id], onDelete: Restrict)
  issuedCredential     AgentCredential? @relation(fields: [issuedCredentialId], references: [id], onDelete: Restrict)
  views                CliAuthorizationView[]

  @@index([status, expiresAt])
  @@index([approvedUserId, createdAt])
  @@schema("workmesh_v1")
}

model CliAuthorizationView {
  authorizationRequestId String @db.Uuid
  webSessionId  String @db.Uuid
  userId        String @db.Uuid
  viewedAt      DateTime @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime @db.Timestamptz(3)
  request       CliAuthorizationRequest @relation(fields: [authorizationRequestId], references: [id], onDelete: Restrict)
  webSession    WebSession @relation(fields: [webSessionId], references: [id], onDelete: Restrict)
  user          User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([authorizationRequestId, webSessionId])
  @@index([webSessionId, expiresAt])
  @@schema("workmesh_v1")
}

model AuthRateWindow {
  id          String @id @default(uuid()) @db.Uuid
  kind        String @db.VarChar(32)
  keyHash     String @db.Char(64)
  windowStart DateTime @db.Timestamptz(3)
  attempts    Int @default(0)
  expiresAt   DateTime @db.Timestamptz(3)

  @@unique([kind, keyHash, windowStart])
  @@index([expiresAt])
  @@schema("workmesh_v1")
}

model IdempotentOperation {
  id                 String @id @default(uuid()) @db.Uuid
  projectId          String? @db.Uuid
  projectScopeKey    String @db.VarChar(80)
  principalScopeKey  String @db.VarChar(80)
  key                String @db.Uuid
  method             String @db.VarChar(8)
  route              String @db.VarChar(200)
  requestDigest      String @db.Char(64)
  resultRefs         Json
  responseMetadata   Json
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  committedAt        DateTime @default(now()) @db.Timestamptz(3)
  project            Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectScopeKey, principalScopeKey, key])
  @@schema("workmesh_v1")
