enum ReviewerKind {
  USER
  BOT
  @@schema("workmesh_v1")
}

enum ReviewEvidenceState {
  APPROVED
  CHANGES_REQUESTED
  DISMISSED
  COMMENTED
  PENDING
  @@schema("workmesh_v1")
}

enum WebhookSource {
  GITHUB
  @@schema("workmesh_v1")
}

/// 不可变代码评审证据：来自外部 GitHub 归一化后落盘，绝不被覆盖或更新内容字段。
model CodeReviewEvidence {
  id               String             @id @default(uuid()) @db.Uuid
  projectId        String             @db.Uuid
  repositoryId     String             @db.VarChar(120)
  changeRequestId  String             @db.VarChar(120)
  headSha          String             @db.Char(40)
  authorExternalId String             @db.VarChar(120)
  reviewerExternalId String           @db.VarChar(120)
  reviewerKind     ReviewerKind
  state            ReviewEvidenceState
  commitSha        String?            @db.Char(40)
  submittedAt      DateTime?          @db.Timestamptz(3)
  reviewExternalId String             @db.VarChar(120)
  artifactSetId    String?            @db.Uuid
  /// 归一化输入的 SHA-256 指纹，作为不可变去重与篡改检测的键。
  evidenceFingerprint String          @db.Char(64)
  /// prepare-code-evidence 绑定到工件集/代次的有版本票据：secretHash + 过期时间；消费后置空。
  preparedSecretHash String?          @db.Char(64)
  preparedExpiresAt   DateTime?       @db.Timestamptz(3)
  /// 票据绑定的已批准证据与工件代次；票据失效后历史仍保留。
  preparedEvidenceId  String?         @db.Uuid
  ticketGeneration    Int?
  receiptId        String?            @db.Uuid
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  project          Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  artifactSet      ArtifactSet?       @relation(fields: [artifactSetId], references: [id], onDelete: Restrict)
  receipt          WebhookReceipt?    @relation(fields: [receiptId], references: [id], onDelete: Restrict)

  @@unique([evidenceFingerprint])
  @@index([projectId, repositoryId, changeRequestId])
  @@index([artifactSetId])
  @@schema("workmesh_v1")
}

/// Webhook 收据：记录每次外部投递的接收、签名校验与处理状态，不可变。
model WebhookReceipt {
  id            String        @id @default(uuid()) @db.Uuid
  projectId     String        @db.Uuid
  source        WebhookSource
  eventType     String        @db.VarChar(64)
  deliveryId    String        @db.VarChar(120)
  signatureValid Boolean
  payloadDigest String        @db.Char(64)
  receivedAt    DateTime      @default(now()) @db.Timestamptz(3)
  processedAt   DateTime?     @db.Timestamptz(3)
  status        String        @db.VarChar(32) @default("PENDING")
  errorMessage  String?       @db.VarChar(400)
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  evidence      CodeReviewEvidence[]

  @@unique([source, deliveryId])
  @@index([projectId, receivedAt])
  @@schema("workmesh_v1")
}

enum SnapshotRefKind {
  DOCUMENT_REVISION
  ARTIFACT
  ROLE_RESOURCE
  @@schema("workmesh_v1")
}

enum SnapshotAuthority {
  PUBLISHED
  CANDIDATE
  @@schema("workmesh_v1")
}

/// 角色包版本一旦登记不可覆盖；改内容必须换 SemVer。projectId 为 null 表示内置包。
model RolePackageVersion {
  id               String                @id @default(uuid()) @db.Uuid
  projectId        String?               @db.Uuid
  packageId        String                @db.VarChar(64)
  version          String                @db.VarChar(64)
  roleKey          String                @db.VarChar(48)
  manifest         Json
  manifestDigest   String                @db.Char(64)
  createdByStampId String?               @db.Uuid
  sourceRef        String?               @db.VarChar(200)
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  project          Project?              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  stamp            PrincipalStamp?       @relation(fields: [createdByStampId], references: [id], onDelete: Restrict)
  resources        RolePackageResource[]

  @@unique([projectId, packageId, version])
  @@index([packageId, version])
  @@schema("workmesh_v1")
}

model RolePackageResource {
  id                   String              @id @default(uuid()) @db.Uuid
  rolePackageVersionId String              @db.Uuid
  resourceKey          String              @db.VarChar(64)
  path                 String              @db.VarChar(300)
  mediaType            String              @db.VarChar(100)
  byteLength           Int
  sha256               String              @db.Char(64)
  bodyBytes            Bytes
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  packageVersion       RolePackageVersion  @relation(fields: [rolePackageVersionId], references: [id], onDelete: Restrict)
  snapshotRefs         SnapshotResourceRef[]

  @@unique([rolePackageVersionId, resourceKey])
  @@unique([rolePackageVersionId, path])
  @@schema("workmesh_v1")
}

/// 项目代码仓库稳定身份：外部 id 由厂商提供且不随重命名变化，任务交付只引用这里登记的仓库。
model ProjectRepository {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @db.Uuid
  adapter       String   @db.VarChar(16)
  externalId    String   @db.VarChar(120)
  owner         String   @db.VarChar(120)
  name          String   @db.VarChar(120)
  defaultBranch String?  @db.VarChar(200)
  archivedAt    DateTime? @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([projectId, adapter, externalId])
  @@schema("workmesh_v1")
}

/// 快照引用：manifest 的每一行都有可验证的资源定位与摘要，读取时按当前授权逐项复核。
model SnapshotResourceRef {
  id                    String               @id @default(uuid()) @db.Uuid
  projectId             String               @db.Uuid
  snapshotId            String               @db.Uuid
  refKey                String               @db.VarChar(80)
  kind                  SnapshotRefKind
  documentRevisionId    String?              @db.Uuid
  artifactId            String?              @db.Uuid
  rolePackageResourceId String?              @db.Uuid
  sha256                String               @db.Char(64)
  byteLength            Int
  mediaType             String               @db.VarChar(100)
  authority             SnapshotAuthority
  snapshot              ContextSnapshot      @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  rolePackageResource   RolePackageResource? @relation(fields: [rolePackageResourceId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, refKey])
  @@index([documentRevisionId])
  @@index([artifactId])
  @@schema("workmesh_v1")
}
