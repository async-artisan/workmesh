/// 不可变代码评审证据：来自外部 GitHub 归一化后落盘，绝不被覆盖或更新内容字段。
model CodeReviewEvidence {
  id               String             @id @default(uuid()) @db.Uuid
  projectId        String             @db.Uuid
  repositoryId     String             @db.VarChar(120)
  changeRequestId  String             @db.VarChar(120)
  headSha          String             @db.Char(40)
  authorExternalId String             @db.VarChar(120)
  reviewerExternalId String           @db.VarChar(120)
  reviewerKind     ReviewerKind
  state            ReviewEvidenceState
  commitSha        String?            @db.Char(40)
  submittedAt      DateTime?          @db.Timestamptz(3)
  reviewExternalId String             @db.VarChar(120)
  artifactSetId    String?            @db.Uuid
  /// 归一化输入的 SHA-256 指纹，作为不可变去重与篡改检测的键。
  evidenceFingerprint String          @db.Char(64)
  /// prepare-code-evidence 绑定到工件集/代次的有版本票据：secretHash + 过期时间；消费后置空。
  preparedSecretHash String?          @db.Char(64)
  preparedExpiresAt   DateTime?       @db.Timestamptz(3)
  /// 票据绑定的已批准证据与工件代次；票据失效后历史仍保留。
  preparedEvidenceId  String?         @db.Uuid
  ticketGeneration    Int?
  receiptId        String?            @db.Uuid
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  project          Project            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  artifactSet      ArtifactSet?       @relation(fields: [artifactSetId], references: [id], onDelete: Restrict)
  receipt          WebhookReceipt?    @relation(fields: [receiptId], references: [id], onDelete: Restrict)

  // 去重只在项目内成立：同一 GitHub 仓库可以被多个项目登记，全局唯一会让先到者
  // 占住键、后到项目复用它的行，于是那个项目永远拿不到属于自己的证据。
  @@unique([projectId, evidenceFingerprint])
  @@index([projectId, repositoryId, changeRequestId])
  @@index([artifactSetId])
  @@schema("workmesh_v1")
}

/// Webhook 收据：记录每次外部投递的接收、签名校验与处理状态，不可变。
