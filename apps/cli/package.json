{
  "name": "@workmesh/cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "LICENSE"
  ],
  "bin": {
    "workmesh": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "pack:check": "pnpm build && pnpm pack --pack-destination /tmp/workmesh-cli-pack",
    "dev": "tsx watch src/index.ts",
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "@workmesh/shared": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
