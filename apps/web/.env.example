# Public CLI-facing API URL. It can differ from the browser origin and may include a proxy prefix.
# Vite embeds this non-secret value at build time; rebuild Web after changing it.
# Use HTTPS, or explicit loopback HTTP for local development. Never put credentials here.
VITE_WORKMESH_PUBLIC_API_URL=http://127.0.0.1:3000/api/v1
