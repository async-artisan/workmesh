{
  "name": "reqflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI-assisted requirements management platform",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:eslint": "eslint .",
    "type-check": "turbo run type-check",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "db:generate": "pnpm --filter @reqflow/api db:generate",
    "db:push": "pnpm --filter @reqflow/api db:push",
    "db:seed": "pnpm --filter @reqflow/api db:seed",
    "test:integration": "bash scripts/test-integration.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.7.4",
    "eslint": "^10.14.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.2"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
