{
  "name": "workmesh",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Evidence-driven project collaboration hub for local AI agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/async-artisan/workmesh.git"
  },
  "homepage": "https://github.com/async-artisan/workmesh#readme",
  "bugs": {
    "url": "https://github.com/async-artisan/workmesh/issues"
  },
  "keywords": [
    "agent-workflow",
    "auditability",
    "human-in-the-loop",
    "project-collaboration"
  ],
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.28.2 <11"
  },
  "scripts": {
    "workmesh": "node apps/cli/dist/index.js",
    "box": "node packages/box/dist/index.js",
    "build:role-packages": "pnpm --filter @workmesh/role-packages build",
    "dev": "turbo run dev",
    "dev:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-local.ps1",
    "dev:local:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-local.ps1 -Check",
    "dev:local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-local.ps1 -Stop",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:eslint": "eslint .",
    "type-check": "turbo run type-check",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,js,jsx,json,md,yml,yaml}\"",
    "db:generate": "pnpm --filter @workmesh/api db:generate",
    "db:push": "pnpm --filter @workmesh/api db:push",
    "test:integration": "node scripts/test-integration.mjs",
    "test:integration:runner": "node --test scripts/test-integration.test.mjs",
    "test:isolated-prisma": "pnpm --filter @workmesh/shared build && node --test scripts/lib/isolated-prisma-paths.test.mjs && node scripts/lib/isolated-prisma.mjs",
    "test:check-database": "pnpm --filter @workmesh/shared build && node scripts/lib/check-test-database.mjs",
    "test:contracts": "pnpm --filter @workmesh/shared build && node scripts/test-contracts.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:github-live": "node scripts/test-github-live.mjs",
    "test:browser": "pnpm --filter @workmesh/shared build && pnpm --filter @workmesh/api build && pnpm --filter @workmesh/web build && pnpm test:browser:run",
    "test:browser:run": "node scripts/test-browser.mjs",
    "test:ui-review": "pnpm exec playwright test --config playwright.ui-review.config.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,mts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.7.4",
    "eslint": "^10.14.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "overrides": {
      "@nestjs/swagger>js-yaml": "^5.4.1",
      "@nestjs/platform-express>multer": "^2.5.0",
      "vitest>vite": "^6.4.4",
      "@vitest/mocker>vite": "^6.4.4",
      "@nestjs/cli>webpack": "^5.112.2"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
