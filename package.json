{
  "name": "workmesh",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Evidence-driven project collaboration hub for local AI agents",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "workmesh": "node apps/cli/dist/index.js",
    "build:role-packages": "pnpm --filter @workmesh/role-packages build",
    "dev": "turbo run dev",
    "dev:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-local.ps1",
    "dev:local:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-local.ps1 -Check",
    "dev:local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-local.ps1 -Stop",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:eslint": "eslint .",
    "type-check": "turbo run type-check",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "db:generate": "pnpm --filter @workmesh/api db:generate",
    "db:push": "pnpm --filter @workmesh/api db:push",
    "test:integration": "bash scripts/test-integration.sh",
    "test:isolated-prisma": "corepack pnpm --filter @workmesh/shared build && node scripts/lib/isolated-prisma.mjs",
    "test:check-database": "corepack pnpm --filter @workmesh/shared build && node scripts/lib/check-test-database.mjs",
    "test:contracts": "corepack pnpm --filter @workmesh/shared build && node scripts/test-contracts.mjs",
    "test:e2e": "corepack pnpm --filter @workmesh/shared build && node scripts/test-e2e.mjs",
    "test:github-live": "node scripts/test-github-live.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.7.4",
    "eslint": "^10.14.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.2"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
